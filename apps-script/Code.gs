function doGet(e) {
  const bridgeMode = e && e.parameter && String(e.parameter.bridge || '') === '1';
  if (bridgeMode) {
    const origin = String(e && e.parameter && e.parameter.origin || '').trim();
    const challenge = String(e && e.parameter && e.parameter.challenge || '');
    const validChallenge = /^[a-f0-9]{32}$/i.test(challenge);
    const allowedOrigins = psbPwaBridgeAllowedOrigins_();
    const originAllowed = allowedOrigins.indexOf(origin) >= 0;
    let token = '';
    let issueError = '';
    if (validChallenge && originAllowed) {
      try {
        token = psbIssuePwaBridgeToken_(origin);
        issueError = token ? '' : String(globalThis.PSB_PWA_BRIDGE_ISSUE_STATUS_ || 'TOKEN_ISSUE_FAILED');
      } catch (bridgeError) {
        issueError = 'TOKEN_ISSUE_EXCEPTION';
        console.error('PWA bridge bootstrap failed: ' + String(bridgeError && bridgeError.stack || bridgeError));
      }
    } else {
      issueError = validChallenge ? 'ORIGIN_NOT_ALLOWED' : 'INVALID_CHALLENGE';
    }

    const template = HtmlService.createTemplateFromFile('Bridge');
    // Always return a challenge-bound diagnostic to the known PWA origin.
    // An unapproved request origin never receives a token or reflected message.
    template.bridgeOrigin = originAllowed ? origin : 'https://appfathanmubina.github.io';
    template.bridgeChallenge = validChallenge ? challenge : '';
    template.bridgeToken = token;
    template.bridgeError = issueError;
    return template.evaluate()
      .setTitle('PSB Fathan Mubina — API Bridge')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  }

  const output = HtmlService.createTemplateFromFile('Index').evaluate();

  // PENTING untuk Apps Script HTML Service:
  // meta viewport yang ditulis langsung di Index.html dapat diabaikan oleh
  // sandbox HTML Service. Google mendokumentasikan bahwa viewport harus
  // ditambahkan melalui HtmlOutput.addMetaTag(). Tanpa ini, Android dapat
  // memberi iframe viewport desktop-width sehingga UI terlihat seperti
  // halaman desktop yang diperkecil.
  output.addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover');

  return output
    .setTitle('PSB Fathan Mubina')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/**
 * DATABASE ACCESS — satu pintu akses Spreadsheet PSB.
 *
 * Web App tidak boleh bergantung pada konteks active spreadsheet.
 * Gunakan ID yang disimpan saat setup; fallback ke active spreadsheet
 * hanya untuk kompatibilitas proyek yang masih bound dan belum memiliki ID.
 */
var PSB_DATABASE_SPREADSHEET_CACHE_ = null;

function getDatabaseSpreadsheet_() {
  if (PSB_DATABASE_SPREADSHEET_CACHE_) return PSB_DATABASE_SPREADSHEET_CACHE_;

  const props = PropertiesService.getScriptProperties();
  const spreadsheetId = String(props.getProperty('PSB_SPREADSHEET_ID') || '').trim();

  if (spreadsheetId) {
    try {
      PSB_DATABASE_SPREADSHEET_CACHE_ = SpreadsheetApp.openById(spreadsheetId);
      return PSB_DATABASE_SPREADSHEET_CACHE_;
    } catch (e) {
      console.error('PSB_DATABASE_OPEN_FAILED: ' + String(e && e.stack || e));
      throw new Error('Database PSB tidak dapat diakses. Periksa PSB_SPREADSHEET_ID dan izin akses akun deployment Apps Script.');
    }
  }

  // Kompatibilitas untuk instalasi lama yang belum menyimpan ID database.
  const activeSpreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  if (activeSpreadsheet) {
    PSB_DATABASE_SPREADSHEET_CACHE_ = activeSpreadsheet;
    return activeSpreadsheet;
  }

  throw new Error('ID database PSB belum dikonfigurasi. Jalankan setup database satu kali dari proyek Apps Script yang terhubung ke Spreadsheet.');
}

function getAppInfo() {
  const ss = getDatabaseSpreadsheet_();
  const props = PropertiesService.getScriptProperties();
  return {
    success: true,
    appName: 'PSB Fathan Mubina',
    activeYear: getConfig_('ACTIVE_YEAR') || '2027/2028',
    spreadsheetIdConfigured: !!(props.getProperty('PSB_SPREADSHEET_ID') || ss.getId()),
    foundationReady: !!ss.getSheetByName('USERS'),
    authReady: !!ss.getSheetByName('SESSIONS') && !!ss.getSheetByName('AUDIT_LOG')
  };
}


const PSB_BRAND_LOGO_URL = 'data:image/png;base64,';

function getPublicConfig(forceRefresh) {
  const cache = CacheService.getScriptCache();
  const cacheKey = 'PSB_PUBLIC_CONFIG_V8';
  if (!forceRefresh) {
    const cached = cache.get(cacheKey);
    if (cached) { try { return JSON.parse(cached); } catch (e) {} }
  }

  const sheet = getDatabaseSpreadsheet_().getSheetByName('CONFIG');
  if (!sheet || sheet.getLastRow() < 2) return { success: true, config: {} };
  const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getValues();
  const config = {};
  // Hanya konfigurasi yang memang dibutuhkan browser yang boleh keluar dari server.
  // Konfigurasi internal (session, security, automation, retention, dll.) tetap server-side.
  const PUBLIC_CONFIG_KEYS = new Set([
    'APP_NAME','APP_VERSION','RELEASE_STAGE','ACTIVE_YEAR','ACTIVE_YEAR_ID',
    'MAINTENANCE_MODE','APP_ICON_URL','APP_LOGO_URL'
  ]);
  values.forEach(r => { if (r[0] && PUBLIC_CONFIG_KEYS.has(String(r[0]))) config[String(r[0])] = r[1]; });

  // Branding memakai satu asset resmi yang berada di GitHub Pages.
  // Nilai APP_ICON_URL / APP_LOGO_URL lama di CONFIG tidak lagi menjadi sumber logo,
  // sehingga aplikasi tidak bergantung pada URL Google Drive untuk branding.
  config.APP_ICON_URL = PSB_BRAND_LOGO_URL;
  config.APP_LOGO_URL = PSB_BRAND_LOGO_URL;
  config.APP_VERSION = config.APP_VERSION || PSB_PRODUCTION_VERSION;
  config.RELEASE_STAGE = config.RELEASE_STAGE || 'PRODUCTION';
  const result = { success: true, config: config };
  try { cache.put(cacheKey, JSON.stringify(result), 60); } catch (e) {}
  return result;
}

// =====================================================
// AUTHENTICATION
// =====================================================

function login(identifier, password) {
  // Catat durasi per tahap untuk diagnosis performa tanpa merekam
  // identifier, password, hash, salt, token, atau data pribadi pengguna.
  const timingStartedAt = Date.now();
  const timingStages = {};
  let timingStage = 'input';
  let timingStageStartedAt = timingStartedAt;

  function enterTimingStage_(name) {
    timingStages[timingStage] = Date.now() - timingStageStartedAt;
    timingStage = name;
    timingStageStartedAt = Date.now();
  }

  function finishLoginTiming_(result, outcome) {
    try {
      timingStages[timingStage] = Date.now() - timingStageStartedAt;
      console.info('AUTH_TIMING ' + JSON.stringify({
        outcome: outcome,
        totalMs: Date.now() - timingStartedAt,
        stages: timingStages
      }));
    } catch (timingError) {}
    return result;
  }

  try {
    identifier = String(identifier || '').trim();
    password = String(password || '');
    if (!identifier || !password || password.length > 1024) {
      return finishLoginTiming_(fail_('No. HP/email dan password wajib diisi dengan benar.'), 'invalid_input');
    }

    const key = normalizeIdentifier_(identifier);
    enterTimingStage_('loginLockCheck');
    const lock = getLoginLock_(key);
    if (lock.locked) {
      return finishLoginTiming_(fail_('Terlalu banyak percobaan. Silakan coba lagi dalam ' + lock.remainingMinutes + ' menit.'), 'locked');
    }

    enterTimingStage_('userLookup');
    let user = findUser_(key);
    if (!user || String(user.status).toUpperCase() !== 'ACTIVE') {
      registerLoginFailure_(key);
      return finishLoginTiming_(fail_('Login gagal. Periksa No. HP/email dan password.'), 'user_unavailable');
    }

    enterTimingStage_('passwordVerification');
    const passwordCheck = verifyPasswordForUser_(password, user);
    if (!passwordCheck.valid) {
      registerLoginFailure_(key);
      return finishLoginTiming_(fail_('Login gagal. Periksa No. HP/email dan password.'), 'password_rejected');
    }

    // Migrasikan akun PBKDF2 kembali ke SHA historis. Login tetap dilanjutkan
    // jika migrasi gagal karena password sudah berhasil diverifikasi.
    if (passwordCheck.needsUpgrade) {
      enterTimingStage_('pbkdf2ToSha256Migration');
      try { migratePbkdf2PasswordToLegacySha256AfterLogin_(user, password); }
      catch (migrationError) { console.warn('AUTH_PASSWORD_HASH_MIGRATION_SKIPPED'); }
      // The migration may have replaced the stored hash. Refresh and verify
      // again before the session commit so a concurrent password reset wins.
      const refreshedUser=findUserById_(user.userId,true);
      if(!refreshedUser || String(refreshedUser.status).toUpperCase()!=='ACTIVE' || !verifyPasswordForUser_(password,refreshedUser).valid){
        registerLoginFailure_(key);
        return finishLoginTiming_(fail_('Login gagal. Periksa No. HP/email dan password.'),'credentials_changed');
      }
      user=refreshedUser;
    }

    // Serialize the final credential check with password changes/resets.
    // A login that verified an old hash before a reset must not create a
    // fresh session after the reset has revoked existing sessions.
    enterTimingStage_('sessionCreation');
    const sessionLock=LockService.getScriptLock();
    try { sessionLock.waitLock(10000); } catch (sessionLockError) {
      return finishLoginTiming_(fail_('Server sedang memproses permintaan lain. Silakan coba kembali.'),'session_lock_timeout');
    }
    let session, credentialsChanged=false;
    try {
      const currentUser=findUserById_(user.userId,true);
      if(!currentUser || String(currentUser.status).toUpperCase()!=='ACTIVE' ||
          currentUser.passwordHash!==user.passwordHash || currentUser.passwordSalt!==user.passwordSalt){
        credentialsChanged=true;
      } else {
        user=currentUser;
        session=createSession_(user.userId);
      }
    } finally { sessionLock.releaseLock(); }
    if(credentialsChanged){
      registerLoginFailure_(key);
      return finishLoginTiming_(fail_('Login gagal. Periksa No. HP/email dan password.'),'credentials_changed');
    }
    enterTimingStage_('clearLoginFailure');
    try { clearLoginFailure_(key); } catch (clearError) {
      console.warn('AUTH_LOGIN_FAILURE_COUNTER_CLEAR_FAILED');
    }

    return finishLoginTiming_({
      success: true,
      sessionToken: session.token,
      user: publicUser_(user),
      mustChangePassword: user.mustChangePassword === true || String(user.mustChangePassword).toUpperCase() === 'TRUE'
    }, 'success');
  } catch (e) {
    console.error('AUTH_LOGIN_FAILED');
    return finishLoginTiming_(fail_('Terjadi kesalahan saat login. Silakan coba lagi.'), 'error');
  }
}

function finalizeLogin(sessionToken) {
  const result = getSessionUser_(sessionToken, false);
  if (!result.success) return result;
  try { updateLastLogin_(result.user.rowNumber); } catch (e) { console.error(e); }
  try { writeAudit_(result.user.userId, 'LOGIN', 'AUTH', result.user.userId, '', '', 'Login berhasil'); } catch (e) { console.error(e); }
  return { success: true };
}

/**
 * Decode uploads only after checking the encoded request size, then verify
 * the actual file signature. Keep the accepted formats aligned with the UI.
 */
function decodeAndValidateUpload_(base64Input, mimeTypeInput, maxBytes) {
  const mimeType = String(mimeTypeInput || '').trim().toLowerCase();
  const encoded = String(base64Input || '').replace(/\s+/g, '');
  const limit = Math.max(1, Math.floor(Number(maxBytes) || 0));
  if (!encoded) return { success: false, message: 'File belum diterima server.' };
  if (!limit || encoded.length > Math.ceil(limit / 3) * 4) {
    return { success: false, message: 'Ukuran file melebihi batas yang diizinkan.' };
  }
  if (!/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(encoded)) {
    return { success: false, message: 'Format data file tidak valid.' };
  }
  const signatures = {
    'application/pdf': function(b) { return b.length >= 5 && b[0] === 37 && b[1] === 80 && b[2] === 68 && b[3] === 70 && b[4] === 45; },
    'image/jpeg': function(b) { return b.length >= 3 && (b[0] & 255) === 255 && (b[1] & 255) === 216 && (b[2] & 255) === 255; },
    'image/png': function(b) { return b.length >= 8 && [137,80,78,71,13,10,26,10].every(function(v,i){ return (b[i] & 255) === v; }); },
    'image/webp': function(b) { return b.length >= 12 && String.fromCharCode.apply(null,b.slice(0,4)) === 'RIFF' && String.fromCharCode.apply(null,b.slice(8,12)) === 'WEBP'; }
  };
  if (!Object.prototype.hasOwnProperty.call(signatures, mimeType)) {
    return { success: false, message: 'Format file tidak didukung.' };
  }
  let bytes;
  try {
    // Decode in bounded chunks. A single 10 MB Base64 decode can exceed
    // Apps Script's transient memory/argument limits for some mobile uploads.
    const chunkSize = 32768; // divisible by four, so Base64 boundaries remain valid
    const decodedChunks = [];
    let totalBytes = 0;
    for (let offset = 0; offset < encoded.length; offset += chunkSize) {
      const chunkBytes = Utilities.base64Decode(encoded.slice(offset, offset + chunkSize));
      decodedChunks.push(chunkBytes);
      totalBytes += chunkBytes.length;
    }
    bytes = new Array(totalBytes);
    let writeOffset = 0;
    decodedChunks.forEach(function(part) {
      for (let i = 0; i < part.length; i++) bytes[writeOffset++] = part[i];
    });
  } catch (e) {
    console.error('PSB_UPLOAD_BASE64_DECODE_FAILED: ' + String(e && e.message || e));
    return { success: false, message: 'Data file tidak valid atau rusak. Silakan pilih file kembali.' };
  }
  if (!bytes || !bytes.length || bytes.length > limit) {
    return { success: false, message: 'Ukuran file melebihi batas yang diizinkan.' };
  }
  if (!signatures[mimeType](bytes)) {
    return { success: false, message: 'Isi file tidak sesuai dengan tipe file yang dikirim.' };
  }
  return { success: true, bytes: bytes, size: bytes.length };
}

// =====================================================
// REGISTRASI AKUN WALI TANPA VERIFIKASI EMAIL
// Email bersifat opsional; minimal satu identitas login (No. HP atau email).
// Password tetap di-hash dan akun langsung dibuat dengan role WALI.
// =====================================================

function validateWaliRegistrationPayload_(payload) {
  payload = payload || {};
  const name = String(payload.name || '').trim();
  const phone = String(payload.phone || '').trim();
  const email = String(payload.email || '').trim();
  const password = String(payload.password || '');
  const confirmPassword = String(payload.confirmPassword || '');
  const phoneNormalized = phone ? normalizePhone_(phone) : '';
  const emailNormalized = email.toLowerCase();

  if (!name || name.length > 120) return {success:false,message:'Nama lengkap wajib diisi (maksimal 120 karakter).'};
  if (phone && !/^62\d{8,13}$/.test(phoneNormalized)) return {success:false,message:'Nomor HP tidak valid. Periksa kembali nomor yang dimasukkan.'};
  if (email && (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))) return {success:false,message:'Format email tidak valid. Kosongkan jika tidak ingin mengisi email.'};
  if (!phoneNormalized && !emailNormalized) return {success:false,message:'Isi minimal salah satu: nomor HP atau email agar dapat digunakan untuk login.'};
  if (password.trim().length === 0 || password.length < 6 || password.length > 128) return {success:false,message:'Password harus terdiri dari 6 sampai 128 karakter dan tidak boleh kosong.'};
  if (password !== confirmPassword) return {success:false,message:'Konfirmasi password tidak sama.'};

  return {success:true,name:name,phone:phone,phoneNormalized:phoneNormalized,email:email,emailNormalized:emailNormalized,password:password};
}

function registerWali(payload) {
  const input = validateWaliRegistrationPayload_(payload);
  if (!input.success) return fail_(input.message);
  const passwordSalt = Utilities.getUuid().replace(/-/g,'').substring(0,32);
  const passwordHash = hashPassword_(input.password, passwordSalt);
  const lock = LockService.getScriptLock();
  try { lock.waitLock(15000); } catch (lockError) { return fail_('Server sedang memproses permintaan lain. Silakan coba kembali beberapa saat lagi.'); }
  try {
    const usersSheet = getDatabaseSpreadsheet_().getSheetByName('USERS');
    if (!usersSheet) return fail_('Database pengguna belum tersedia.');

    const users = sheetRowsByFields_(usersSheet, ['phone','phoneNormalized','email','emailNormalized']);
    const duplicate = users.some(function(r) {
      const existingPhone = String(r.phoneNormalized || '').trim() || (r.phone ? normalizePhone_(r.phone) : '');
      const existingEmail = String(r.emailNormalized || '').trim().toLowerCase() || String(r.email || '').trim().toLowerCase();
      return (input.phoneNormalized && existingPhone === input.phoneNormalized) ||
        (input.emailNormalized && existingEmail === input.emailNormalized);
    });
    if (duplicate) return fail_('Nomor HP atau email sudah terdaftar. Silakan masuk atau gunakan data lain.');

    const userId = generateId_('USR');
    const createdAt = new Date();
    usersSheet.appendRow(safeSheetRow_([
      userId,input.name,input.phone,input.phoneNormalized,input.email,input.emailNormalized,
      passwordHash,passwordSalt,'WALI','ACTIVE','','',createdAt,createdAt,false
    ]));

    writeAudit_(userId,'REGISTER','AUTH',userId,'',JSON.stringify({
      phone:input.phoneNormalized ? input.phoneNormalized : '',
      emailProvided:!!input.emailNormalized,
      role:'WALI'
    }),'Akun WALI berhasil dibuat tanpa verifikasi email');

    const user = findUserById_(userId,true);
    const session = createSession_(userId);
    return {
      success:true,
      message:'Akun Wali berhasil dibuat.',
      sessionToken:session.token,
      user:publicUser_(user),
      mustChangePassword:false
    };
  } catch (e) {
    console.error('WALI_REGISTRATION_FAILED');
    return fail_('Pendaftaran belum dapat diselesaikan. Silakan coba kembali.');
  } finally {
    lock.releaseLock();
  }
}

function getInitialAppData(sessionToken) {
  const result = getSessionUser_(sessionToken, true);
  if (!result.success) return result;
  const user = result.user;
  const roles = String(user.role || '').split(',').map(x => x.trim().toUpperCase()).filter(Boolean);
  const data = {
    success: true,
    ready: true,
    appName: getConfig_('APP_NAME') || 'PSB Fathan Mubina',
    activeYear: getConfig_('ACTIVE_YEAR') || '2027/2028',
    roles: roles
  };
  // Lightweight preload only: do not fetch documents/files/payments here.
  if (roles.indexOf('WALI') >= 0) {
    const sheet = getDatabaseSpreadsheet_().getSheetByName(PSB_SHEETS.REGISTRATIONS);
    if (sheet && sheet.getLastRow() >= 2) {
      const headers = sheet.getRange(1,1,1,sheet.getLastColumn()).getValues()[0].map(String);
      const rows = sheet.getRange(2,1,sheet.getLastRow()-1,sheet.getLastColumn()).getValues();
      data.registrationCount = rows.filter(r => String(r[headers.indexOf('userId')] || '') === String(user.userId)).length;
    } else data.registrationCount = 0;
  }
  return data;
}

function validateSession(sessionToken) {
  const result = getSessionUser_(sessionToken, true);
  if (!result.success) return result;
  return { success: true, user: publicUser_(result.user), expiresAt: result.expiresAt, mustChangePassword: result.user.mustChangePassword === true || String(result.user.mustChangePassword).toUpperCase() === 'TRUE' };
}

function logout(sessionToken) {
  const result = getSessionUser_(sessionToken, false);
  if (!result.success) return { success: true };
  if(!invalidateSession_(result.sessionRow, 'LOGOUT'))return fail_('Sesi belum berhasil diakhiri. Silakan coba kembali.');
  writeAudit_(result.user.userId, 'LOGOUT', 'AUTH', result.user.userId, '', '', 'Logout berhasil');
  return { success: true };
}

function changePassword(sessionToken, currentPassword, newPassword) {
  const result = getSessionUser_(sessionToken, true);
  if (!result.success) return result;
  const currentPasswordValue = String(currentPassword || '');
  const newPasswordValue = String(newPassword || '');
  if (currentPasswordValue.length > 1024) return fail_('Password lama tidak valid.');
  if (newPasswordValue.trim().length === 0 || newPasswordValue.length < 6 || newPasswordValue.length > 128) return fail_('Password baru harus terdiri dari 6 sampai 128 karakter.');
  if (newPasswordValue === currentPasswordValue) return fail_('Password baru harus berbeda dari password lama.');

  // Verify and derive hashes before taking the global ScriptLock.
  // Recheck the stored hash and status under lock before committing the change.
  const oldPasswordCheck = verifyPasswordForUser_(currentPasswordValue, result.user);
  if (!oldPasswordCheck.valid) return fail_('Password lama tidak sesuai.');
  const salt = Utilities.getUuid().replace(/-/g, '').substring(0, 32);
  const hash = hashPassword_(newPasswordValue, salt);

  const lock = LockService.getScriptLock();
  try { lock.waitLock(20000); } catch (lockError) { return fail_('Server sedang memproses permintaan lain. Silakan coba kembali beberapa saat lagi.'); }
  try {
    const current = findUserById_(result.user.userId, true);
    if (!current || String(current.status).toUpperCase() !== 'ACTIVE' ||
        current.passwordHash !== result.user.passwordHash ||
        current.passwordSalt !== result.user.passwordSalt) {
      return fail_('Data password telah berubah. Silakan masuk kembali sebelum mengganti password.');
    }
    const sheet = getDatabaseSpreadsheet_().getSheetByName('USERS');
    sheet.getRange(current.rowNumber, 7, 1, 3).setValues([[hash, salt, current.role]]);
    sheet.getRange(current.rowNumber, 14, 1, 2).setValues([[new Date(), false]]);
    revokeOtherSessionsForUser_(current.userId, String(result.sessionRow.rowNumber));
    try { CacheService.getScriptCache().remove('PSB_USER_V3_' + sha256Hex_(String(current.phoneNormalized || '').toLowerCase()).substring(0, 32)); } catch (e) {}
    if (current.emailNormalized) { try { CacheService.getScriptCache().remove('PSB_USER_V3_' + sha256Hex_(String(current.emailNormalized || '').toLowerCase()).substring(0, 32)); } catch (e) {} }
    try { CacheService.getScriptCache().remove('PSB_USER_ID_' + sha256Hex_(String(current.userId)).substring(0, 32)); } catch (e) {}
    writeAudit_(current.userId, 'CHANGE_PASSWORD', 'AUTH', current.userId, '', '', 'Password berhasil diubah');
    return { success: true, message: 'Password berhasil diubah.' };
  } finally {
    lock.releaseLock();
  }
}

// =====================================================
// AUTHORIZATION HELPERS
// =====================================================

function getCurrentUser(sessionToken) {
  const result = getSessionUser_(sessionToken, true);
  if (!result.success) return result;
  return { success: true, user: publicUser_(result.user) };
}

function hasRole(sessionToken, allowedRoles) {
  const result = getSessionUser_(sessionToken, true);
  if (!result.success) return result;
  const roles = Array.isArray(allowedRoles) ? allowedRoles : [allowedRoles];
  const userRoles = String(result.user.role || '').split(',').map(r => r.trim().toUpperCase()).filter(Boolean);
  return { success: true, authorized: roles.some(r => userRoles.indexOf(String(r).toUpperCase()) >= 0) };
}

function requireRole_(sessionToken, allowedRoles) {
  const result = getSessionUser_(sessionToken, true);
  if (!result.success) throw new Error(result.message || 'Session tidak valid.');
  const roles = Array.isArray(allowedRoles) ? allowedRoles : [allowedRoles];
  const userRoles = String(result.user.role || '').split(',').map(r => r.trim().toUpperCase());
  if (!roles.some(r => userRoles.indexOf(String(r).toUpperCase()) >= 0)) throw new Error('Anda tidak memiliki hak akses untuk tindakan ini.');
  return result.user;
}

function assertRegistrationOpenForNew_() {
  const open = String(getConfig_('REGISTRATION_OPEN') || '').toUpperCase() === 'TRUE';
  if (!open) throw new Error('Pendaftaran sedang ditutup. Draft pendaftaran baru tidak dapat dibuat.');
  const start = String(getConfig_('REGISTRATION_START') || '').trim();
  const end = String(getConfig_('REGISTRATION_END') || '').trim();
  const now = new Date();
  if (start) { const d=new Date(start+'T00:00:00'); if (!isNaN(d.getTime()) && now < d) throw new Error('Pendaftaran belum memasuki tanggal pembukaan.'); }
  if (end) { const d=new Date(end+'T23:59:59'); if (!isNaN(d.getTime()) && now > d) throw new Error('Periode pendaftaran telah berakhir.'); }
  return true;
}

function assertOperationalMutation_(actor) {
  if (!actor) throw new Error('Session tidak valid.');
  const maintenance = String(getConfig_('MAINTENANCE_MODE') || '').toUpperCase() === 'TRUE';
  if (!maintenance) return true;
  if (hasRoleDirect_(actor, ['SUPERADMIN','ADMIN_PSB'])) return true;
  throw new Error('Sistem sedang dalam mode pemeliharaan. Tindakan perubahan data sementara dinonaktifkan.');
}

function productionConfigObject_() {
  const keys = ['APP_NAME','APP_VERSION','RELEASE_STAGE','ACTIVE_YEAR','ACTIVE_YEAR_ID','REGISTRATION_OPEN','REGISTRATION_START','REGISTRATION_END','MAINTENANCE_MODE','TIMEZONE'];
  const out = {};
  keys.forEach(k => out[k] = getConfig_(k));
  if (!out.APP_VERSION) out.APP_VERSION = PSB_PRODUCTION_VERSION;
  if (!out.RELEASE_STAGE) out.RELEASE_STAGE = 'PRODUCTION';
  return out;
}

function getProductionControlData(sessionToken) {
  const actor = requireRole_(sessionToken, PSB_PRODUCTION_ADMIN_ROLES);
  const ss = getDatabaseSpreadsheet_();
  const users = sheetRows_(ss.getSheetByName(PSB_SHEETS.USERS));
  const activeSuperadmins = users.filter(u => String(u.status||'').toUpperCase()==='ACTIVE' && String(u.role||'').toUpperCase().split(',').map(x=>x.trim()).indexOf('SUPERADMIN')>=0);
  const mustChange = activeSuperadmins.filter(u => String(u.mustChangePassword||'').toUpperCase()==='TRUE' || u.mustChangePassword===true).length;
  return {success:true, config:productionConfigObject_(), activeSuperadmins:activeSuperadmins.length, superadminsNeedingPasswordChange:mustChange, actorRole:actor.role, generatedAt:new Date().toISOString()};
}

function setProductionControl(sessionToken, payload) {
  const actor = requireRole_(sessionToken, ['SUPERADMIN']);
  payload = payload || {};
  const changes = {};
  const allowed = ['APP_VERSION','RELEASE_STAGE','REGISTRATION_OPEN','REGISTRATION_START','REGISTRATION_END','MAINTENANCE_MODE'];
  allowed.forEach(k => { if (Object.prototype.hasOwnProperty.call(payload,k)) changes[k] = payload[k]; });
  if (changes.RELEASE_STAGE) changes.RELEASE_STAGE = String(changes.RELEASE_STAGE).trim().toUpperCase();
  if (changes.APP_VERSION) changes.APP_VERSION = String(changes.APP_VERSION).trim();
  if (changes.APP_VERSION && !/^\d+\.\d+(?:\.\d+)?(?:[-._A-Za-z0-9]+)?$/.test(changes.APP_VERSION)) return fail_('Format APP_VERSION tidak valid.');
  ['REGISTRATION_OPEN','MAINTENANCE_MODE'].forEach(k => { if (Object.prototype.hasOwnProperty.call(changes,k)) changes[k] = (changes[k]===true || String(changes[k]).toUpperCase()==='TRUE') ? 'TRUE' : 'FALSE'; });
  const sheet = getDatabaseSpreadsheet_().getSheetByName(PSB_SHEETS.CONFIG);
  if (!sheet) return fail_('Sheet CONFIG belum tersedia.');
  const old = productionConfigObject_();
  const headers = sheet.getRange(1,1,1,sheet.getLastColumn()).getValues()[0].map(String);
  const keyIdx=headers.indexOf('key'), valueIdx=headers.indexOf('value'), updatedIdx=headers.indexOf('updatedAt');
  if (keyIdx<0 || valueIdx<0) return fail_('Struktur CONFIG tidak sesuai.');
  const rows=sheet.getLastRow()>=2?sheet.getRange(2,1,sheet.getLastRow()-1,sheet.getLastColumn()).getValues():[];
  const index={}; rows.forEach((r,i)=>index[String(r[keyIdx]||'')]=i+2);
  Object.keys(changes).forEach(k=>{
    const row=index[k];
    if (!row) { const values=new Array(headers.length).fill(''); values[keyIdx]=k; values[valueIdx]=changes[k]; if(updatedIdx>=0) values[updatedIdx]=new Date(); sheet.appendRow(values); }
    else { sheet.getRange(row,valueIdx+1).setValue(changes[k]); if(updatedIdx>=0) sheet.getRange(row,updatedIdx+1).setValue(new Date()); }
    try { const configCache = CacheService.getScriptCache(); configCache.remove('PSB_CFG_'+sha256Hex_(k).substring(0,24)); configCache.remove('PSB_CFG_MAP_V1'); } catch(e){}
  });
  try { CacheService.getScriptCache().remove('PSB_PUBLIC_CONFIG_V5'); CacheService.getScriptCache().remove('PSB_PUBLIC_CONFIG_V4'); } catch(e){}
  writeAudit_(actor.userId,'PRODUCTION_CONFIG_UPDATE','SYSTEM','',JSON.stringify(old),JSON.stringify(productionConfigObject_()),'Konfigurasi produksi diubah oleh SUPERADMIN');
  return {success:true,message:'Kontrol produksi berhasil diperbarui.',config:productionConfigObject_()};
}

function getDataIntegrityReport(sessionToken) {
  const actor = requireRole_(sessionToken, PSB_PRODUCTION_ADMIN_ROLES);
  const ss = getDatabaseSpreadsheet_();
  const checks=[];
  const add=(key,label,status,detail,category)=>checks.push({key,label,status,detail,category});
  const rowsBy=name=>sheetRows_(ss.getSheetByName(name));
  const exists=name=>!!ss.getSheetByName(name);
  const refs=[
    ['REGISTRATIONS','userId','USERS','userId'],['REGISTRATIONS','candidateId','CANDIDATES','candidateId'],['REGISTRATIONS','tahunAjaranId','MASTER_TAHUN_AJARAN','tahunAjaranId'],['REGISTRATIONS','gelombangId','MASTER_GELOMBANG','gelombangId'],['REGISTRATIONS','jenjangId','MASTER_JENJANG','jenjangId'],
    ['GUARDIANS','userId','USERS','userId'],['GUARDIANS','candidateId','CANDIDATES','candidateId'],['ADDRESSES','candidateId','CANDIDATES','candidateId'],['SCHOOLS','candidateId','CANDIDATES','candidateId'],
    ['DOCUMENTS','registrationId','REGISTRATIONS','registrationId'],['DOCUMENTS','documentTypeId','MASTER_DOKUMEN','documentTypeId'],['BILLS','registrationId','REGISTRATIONS','registrationId'],['BILLS','paymentTypeId','MASTER_JENIS_PEMBAYARAN','paymentTypeId'],['PAYMENTS','billId','BILLS','billId'],['PAYMENTS','registrationId','REGISTRATIONS','registrationId'],['PAYMENT_VERIFICATIONS','paymentId','PAYMENTS','paymentId'],
    ['SELECTION_SCHEDULE','tahunAjaranId','MASTER_TAHUN_AJARAN','tahunAjaranId'],['SELECTION_PARTICIPANTS','registrationId','REGISTRATIONS','registrationId'],['SELECTION_PARTICIPANTS','scheduleId','SELECTION_SCHEDULE','scheduleId'],['SELECTION_SCORES','participantId','SELECTION_PARTICIPANTS','participantId'],['SELECTION_RESULTS','registrationId','REGISTRATIONS','registrationId'],['REREGISTRATIONS','registrationId','REGISTRATIONS','registrationId']
  ];
  const cache={};
  const getSet=(sheet,field)=>{const k=sheet+'|'+field;if(cache[k])return cache[k]; const set={}; rowsBy(sheet).forEach(r=>{const v=String(r[field]||'').trim();if(v)set[v]=true;}); return cache[k]=set;};
  let orphan=0;
  refs.forEach(([sheet,field,target,targetField])=>{
    if(!exists(sheet)||!exists(target)){ add('ref_'+sheet+'_'+field, sheet+'.'+field+' → '+target+'.'+targetField,'WARNING','Sheet referensi belum tersedia; pemeriksaan dilewati.','References'); return; }
    const targetSet=getSet(target,targetField); const bad=rowsBy(sheet).filter(r=>{const v=String(r[field]||'').trim();return v && !targetSet[v];});
    orphan+=bad.length; add('ref_'+sheet+'_'+field, sheet+'.'+field+' → '+target+'.'+targetField,bad.length?'ERROR':'OK',bad.length?bad.length+' baris memiliki referensi yang tidak ditemukan.':'Semua referensi valid.','References');
  });
  // Cover every persisted primary identifier, not only the original core tables.
  const duplicateSpecs=[
    ['CONFIG','key'],['USERS','userId'],['SESSIONS','sessionId'],['AUDIT_LOG','auditId'],['NOTIFICATIONS','notificationId'],
    ['MASTER_TAHUN_AJARAN','tahunAjaranId'],['MASTER_GELOMBANG','gelombangId'],['MASTER_JENJANG','jenjangId'],
    ['MASTER_KELAS','kelasId'],['MASTER_DOKUMEN','documentTypeId'],['MASTER_JENIS_PEMBAYARAN','paymentTypeId'],
    ['REGISTRATIONS','registrationId'],['CANDIDATES','candidateId'],['GUARDIANS','guardianId'],['ADDRESSES','addressId'],
    ['SCHOOLS','schoolId'],['DOCUMENTS','documentId'],['BILLS','billId'],['PAYMENTS','paymentId'],
    ['PAYMENT_VERIFICATIONS','verificationId'],['SELECTION_SCHEDULE','scheduleId'],['SELECTION_PARTICIPANTS','participantId'],
    ['SELECTION_SCORES','scoreId'],['SELECTION_RESULTS','resultId'],['REREGISTRATIONS','reregistrationId'],
    ['INCIDENTS','incidentId'],['MIGRATION_LOG','migrationId']
  ];
  let dup=0;
  duplicateSpecs.forEach(([sheet,field])=>{
    const key='dup_'+sheet+'_'+field;
    if(!exists(sheet)){add(key,sheet+'.'+field,'WARNING','Sheet belum tersedia; pemeriksaan duplikasi dilewati.','Identifiers');return;}
    const seen={};rowsBy(sheet).forEach(r=>{const v=String(r[field]||'').trim();if(v)seen[v]=(seen[v]||0)+1;});
    const bad=Object.keys(seen).filter(k=>seen[k]>1);dup+=bad.length;
    add(key,sheet+'.'+field,bad.length?'ERROR':'OK',bad.length?'Duplikasi: '+bad.slice(0,8).join(', '):'Tidak ada ID duplikat.','Identifiers');
  });

  // Business keys protect one-to-one workflow relationships even when row IDs differ.
  const businessUniqueSpecs=[
    {key:'unique_registration_number',label:'REGISTRATIONS.registrationNumber',sheet:'REGISTRATIONS',getKey:r=>String(r.registrationNumber||'').trim()},
    {key:'unique_active_bill_type',label:'BILLS.registrationId + paymentTypeId (non-CANCELLED)',sheet:'BILLS',getKey:r=>{const registrationId=String(r.registrationId||'').trim(),paymentTypeId=String(r.paymentTypeId||'').trim();return String(r.status||'').toUpperCase()==='CANCELLED'||!registrationId||!paymentTypeId?'':[registrationId,paymentTypeId].join('|');}},
    {key:'unique_active_payment_per_bill',label:'PAYMENTS.billId (SUBMITTED/VERIFIED)',sheet:'PAYMENTS',getKey:r=>['SUBMITTED','VERIFIED'].includes(String(r.status||'').toUpperCase())?String(r.billId||'').trim():''},
    {key:'unique_payment_verification',label:'PAYMENT_VERIFICATIONS.paymentId',sheet:'PAYMENT_VERIFICATIONS',getKey:r=>String(r.paymentId||'').trim()},
    {key:'unique_current_document_type',label:'DOCUMENTS.registrationId + documentTypeId (non-REPLACED)',sheet:'DOCUMENTS',getKey:r=>{const registrationId=String(r.registrationId||'').trim(),documentTypeId=String(r.documentTypeId||'').trim();return String(r.status||'').toUpperCase()==='REPLACED'||!registrationId||!documentTypeId?'':[registrationId,documentTypeId].join('|');}},
    {key:'unique_selection_participant',label:'SELECTION_PARTICIPANTS.registrationId',sheet:'SELECTION_PARTICIPANTS',getKey:r=>String(r.registrationId||'').trim()},
    {key:'unique_selection_score_component',label:'SELECTION_SCORES.participantId + component',sheet:'SELECTION_SCORES',getKey:r=>{const participantId=String(r.participantId||'').trim(),component=String(r.component||'').trim().toLowerCase();return participantId&&component?[participantId,component].join('|'):'';}},
    {key:'unique_selection_result',label:'SELECTION_RESULTS.registrationId',sheet:'SELECTION_RESULTS',getKey:r=>String(r.registrationId||'').trim()},
    {key:'unique_reregistration',label:'REREGISTRATIONS.registrationId',sheet:'REREGISTRATIONS',getKey:r=>String(r.registrationId||'').trim()}
  ];
  businessUniqueSpecs.forEach(spec=>{
    if(!exists(spec.sheet)){add(spec.key,spec.label,'WARNING','Sheet belum tersedia; pemeriksaan relasi unik dilewati.','Business Keys');return;}
    const seen={};rowsBy(spec.sheet).forEach(r=>{const v=spec.getKey(r);if(v)seen[v]=(seen[v]||0)+1;});
    const bad=Object.keys(seen).filter(k=>seen[k]>1);dup+=bad.length;
    add(spec.key,spec.label,bad.length?'ERROR':'OK',bad.length?'Duplikasi: '+bad.slice(0,8).join(', '):'Tidak ada duplikasi relasi.','Business Keys');
  });
  const testTokens=['TEST-','example.test']; let testRows=0; Object.keys(PSB_SHEETS).forEach(k=>{const name=PSB_SHEETS[k];rowsBy(name).forEach(r=>{const joined=Object.keys(r).map(x=>String(r[x]||'')).join('|');if(testTokens.some(t=>joined.indexOf(t)>=0))testRows++;});});
  add('testData','Dummy/test indicators',testRows?'WARNING':'OK',testRows?testRows+' baris terindikasi sebagai data test/dummy.':'Tidak ditemukan indikator TEST-/example.test.','Production');
  add('orphanSummary','Total orphan references',orphan?'ERROR':'OK',orphan?orphan+' referensi orphan ditemukan.':'Tidak ada orphan reference.','Summary');
  add('duplicateSummary','Total kelompok duplikasi identifier/relasi',dup?'ERROR':'OK',dup?dup+' kelompok duplikasi identifier/relasi ditemukan.':'Tidak ada kelompok duplikasi identifier/relasi.','Summary');
  const errors=checks.filter(x=>x.status==='ERROR').length, warnings=checks.filter(x=>x.status==='WARNING').length;
  const result={success:true,checks,summary:{total:checks.length,errors,warnings,ok:checks.length-errors-warnings},productionReady:errors===0,checkedAt:new Date().toISOString()};
  writeAudit_(actor.userId,'DATA_INTEGRITY_CHECK','SYSTEM','', '', JSON.stringify({errors,warnings,orphan,dup}), 'Pemeriksaan integritas data produksi dijalankan');
  return result;
}

function createProductionBackup(sessionToken) {
  const actor=requireRole_(sessionToken,['SUPERADMIN']);
  const ss=getDatabaseSpreadsheet_();
  const props=PropertiesService.getScriptProperties();
  let folder=null; const yearId=String(props.getProperty('PSB_DRIVE_YEAR_ID')||'').trim();
  if(yearId){try{folder=DriveApp.getFolderById(yearId);}catch(e){folder=null;}}
  if(!folder){let root=null;const rootId=String(props.getProperty('PSB_DRIVE_ROOT_ID')||'').trim();if(rootId){try{root=DriveApp.getFolderById(rootId);}catch(e){}} if(root)folder=root;}
  if(!folder) throw new Error('Folder Drive produksi tidak tersedia.');
  const source=DriveApp.getFileById(ss.getId());
  const stamp=Utilities.formatDate(new Date(),getConfig_('TIMEZONE')||'Asia/Jakarta','yyyyMMdd_HHmmss');
  const copy=source.makeCopy('BACKUP_PSB_'+String(getConfig_('ACTIVE_YEAR')||'NA').replace(/[^A-Za-z0-9-]/g,'-')+'_'+stamp,folder);
  writeAudit_(actor.userId,'PRODUCTION_BACKUP','SYSTEM',copy.getId(),'','', 'Backup spreadsheet produksi dibuat');
  return {success:true,message:'Backup spreadsheet berhasil dibuat.',fileId:copy.getId(),fileName:copy.getName(),createdAt:new Date().toISOString()};
}

