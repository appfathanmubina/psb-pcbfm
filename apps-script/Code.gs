  }));
  return {success:true,actorRole:actor.role,roleCounts,activeUsers:activeUsers.length,recent,automation:[
    {event:'Pendaftaran dikirim',target:'SUPERADMIN, ADMIN_PSB, VERIFIKATOR, WALI',enabled:true},
