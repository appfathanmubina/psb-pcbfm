}

function withScriptLock_(timeoutMs, callback) {
  const lock = LockService.getScriptLock();
  try { lock.waitLock(timeoutMs || 10000); } catch (lockError) { return fail_('Server sedang memproses permintaan lain. Silakan coba kembali beberapa saat lagi.'); }
  try { return callback(); } finally { lock.releaseLock(); }
}

// =====================================================
// SESSION
// =====================================================

function createSession_(userId) {
  const token = Utilities.getUuid() + Utilities.getUuid();
  const tokenHash = sha256Hex_(token);
  const now = new Date();
  const ttl = Number(getConfig_('SESSION_TTL_MINUTES')) || PSB_AUTH.SESSION_TTL_MINUTES;
  const expires = new Date(now.getTime() + ttl * 60000);
  const sessionId = generateId_('SES');
  const sheet = getDatabaseSpreadsheet_().getSheetByName('SESSIONS');
  sheet.appendRow([sessionId, userId, tokenHash, now, expires, now, 'ACTIVE']);
  // Seed the row index immediately so finalizeLogin and the first API call do not scan SESSIONS.
  try { CacheService.getScriptCache().put('PSB_SESSION_ROW_V1_' + tokenHash.substring(0, 40), String(sheet.getLastRow()), 21600); } catch (e) {}
  return { token: token, expiresAt: expires.toISOString(), sessionId: sessionId };
}

function getSessionUser_(token, touch) {
  token = String(token || '');
  // Token sesi yang diterbitkan createSession_ adalah dua UUID (72 karakter).
  if (!token || token.length < 32 || token.length > 256) return fail_('Session tidak ditemukan. Silakan login kembali.');

  const tokenHash = sha256Hex_(token);
  const cache = CacheService.getScriptCache();
  const sessionCacheKey = 'PSB_SESSION_ROW_V1_' + tokenHash.substring(0, 40);
  const sheet = getDatabaseSpreadsheet_().getSheetByName('SESSIONS');
  if (!sheet) return fail_('Session tidak ditemukan. Silakan login kembali.');

  // Cache hanya menyimpan nomor baris, bukan status sesi. Status, expiry, dan
  // aktivitas tetap dibaca langsung dari Spreadsheet agar logout/revoke berlaku segera.
  let found = null;
  // Indeks cache bukan sumber kebenaran sesi. Jika cache gagal dibaca,
  // lakukan fallback ke Spreadsheet seperti pada cache miss biasa.
  let cachedRowNumber = 0;
  try { cachedRowNumber = Number(cache.get(sessionCacheKey) || 0); } catch (cacheReadError) {}
  if (cachedRowNumber >= 2) {
    try {
      const cachedRow = sheet.getRange(cachedRowNumber, 1, 1, 7).getValues()[0];
      if (constantTimeEqual_(String(cachedRow[2] || ''), tokenHash)) {
        found = { rowNumber: cachedRowNumber, row: cachedRow };
      } else {
        try { cache.remove(sessionCacheKey); } catch (cacheRemoveError) {}
      }
    } catch (e) {
      try { cache.remove(sessionCacheKey); } catch (cacheRemoveError) {}
    }
  }

  // Cache miss/stale index: lakukan scan penuh satu kali, lalu simpan lokasi baris.
  if (!found) {
    const lastRow = sheet.getLastRow();
    if (lastRow >= 2) {
      // Token hash is column C. Scan this narrow column from newest to oldest
      // (same precedence as before), then fetch the complete row only on match.
      const tokenHashes = sheet.getRange(2, 3, lastRow - 1, 1).getValues();
      for (let i = tokenHashes.length - 1; i >= 0; i--) {
        if (constantTimeEqual_(String(tokenHashes[i][0] || ''), tokenHash)) {
          const rowNumber = i + 2;
          const row = sheet.getRange(rowNumber, 1, 1, 7).getValues()[0];
          found = { rowNumber: rowNumber, row: row };
          try { cache.put(sessionCacheKey, String(found.rowNumber), 21600); } catch (e) {}
          break;
        }
      }
    }
  }
  if (!found) return fail_('Session tidak valid. Silakan login kembali.');

  const row = found.row;
  if (String(row[6] || '').toUpperCase() !== 'ACTIVE') return fail_('Session sudah berakhir. Silakan login kembali.');
  const now = new Date();
  const expiresAt = row[4] ? new Date(row[4]) : null;
  if (!expiresAt || !Number.isFinite(expiresAt.getTime())) {
    invalidateSession_(found, 'INVALID_EXPIRY');
    return fail_('Session tidak valid. Silakan login kembali.');
  }
  if (expiresAt <= now) {
    invalidateSession_(found, 'EXPIRED');
    return fail_('Session sudah berakhir. Silakan login kembali.');
  }
  const idleMinutes = Number(getConfig_('SESSION_IDLE_MINUTES')) || PSB_AUTH.SESSION_IDLE_MINUTES;
  const lastActivity = row[5] ? new Date(row[5]) : (row[3] ? new Date(row[3]) : null);
  if (!lastActivity || !Number.isFinite(lastActivity.getTime()) || lastActivity.getTime() > now.getTime() + 5 * 60000) {
    invalidateSession_(found, 'INVALID_ACTIVITY');
    return fail_('Session tidak valid. Silakan login kembali.');
  }
  if ((now.getTime() - lastActivity.getTime()) > idleMinutes * 60000) {
    invalidateSession_(found, 'IDLE_TIMEOUT');
    return fail_('Session berakhir karena tidak aktif. Silakan login kembali.');
  }

  // Baca data akun terbaru, tetapi gunakan indeks row-number agar tidak memindai
  // seluruh USERS pada setiap pemanggilan API.
  const user = findUserById_(String(row[1]), true);
  if (!user || String(user.status).toUpperCase() !== 'ACTIVE') {
    invalidateSession_(found, 'ACCOUNT_INACTIVE');
    return fail_('Akun tidak aktif.');
  }

  // Batasi penulisan lastActivity maksimal sekali per 2 menit per sesi.
  // Gunakan lock yang sama dengan cleanup/logout agar penulisan aktivitas
  // tidak berlomba dengan pencabutan atau timeout sesi.
  if (touch && (now.getTime() - lastActivity.getTime()) >= 2 * 60000) {
    const touchLock=LockService.getScriptLock();
    try { touchLock.waitLock(5000); } catch (touchLockError) {
      return fail_('Server sedang memproses sesi. Silakan coba kembali.');
    }
    try {
      const latestRow=sheet.getRange(found.rowNumber,1,1,7).getValues()[0];
      if(!constantTimeEqual_(String(latestRow[2]||''),tokenHash) || String(latestRow[6]||'').toUpperCase()!=='ACTIVE'){
        return fail_('Session sudah berakhir. Silakan login kembali.');
      }
      const touchNow=new Date();
      const latestExpiry=latestRow[4]?new Date(latestRow[4]):null;
      const latestActivity=latestRow[5]?new Date(latestRow[5]):(latestRow[3]?new Date(latestRow[3]):null);
      let invalidStatus='';
      if(!latestExpiry || !Number.isFinite(latestExpiry.getTime()))invalidStatus='INVALID_EXPIRY';
      else if(latestExpiry<=touchNow)invalidStatus='EXPIRED';
      else if(!latestActivity || !Number.isFinite(latestActivity.getTime()) || latestActivity.getTime()>touchNow.getTime()+5*60000)invalidStatus='INVALID_ACTIVITY';
      else if((touchNow.getTime()-latestActivity.getTime())>idleMinutes*60000)invalidStatus='IDLE_TIMEOUT';
      if(invalidStatus){
        sheet.getRange(found.rowNumber,7).setValue(invalidStatus);
        try{cache.remove(sessionCacheKey);}catch(cacheRemoveError){}
        return fail_(invalidStatus==='IDLE_TIMEOUT'?'Session berakhir karena tidak aktif. Silakan login kembali.':'Session sudah berakhir. Silakan login kembali.');
      }
      if((touchNow.getTime()-latestActivity.getTime())>=2*60000){
        sheet.getRange(found.rowNumber,6).setValue(touchNow);
        row[5]=touchNow;
      } else {
        row[5]=latestRow[5];
      }
    } finally { touchLock.releaseLock(); }
  }
  return { success: true, user: user, sessionRow: found, expiresAt: expiresAt.toISOString() };
}

function revokeOtherSessionsForUser_(userId, keepRowNumber) {
  const sheet = getDatabaseSpreadsheet_().getSheetByName('SESSIONS');
  if (!sheet || sheet.getLastRow() < 2) return 0;
  const lastRow = sheet.getLastRow();
  const rows = sheet.getRange(2,1,lastRow-1,7).getValues();
  const statusValues = rows.map(row => [row[6]]);
  const revokedHashes = [];
  const keep = Number(keepRowNumber || 0);
  let count = 0;
  for (let i=0;i<rows.length;i++) {
    const rowNumber=i+2;
    if (rowNumber===keep) continue;
    if (String(rows[i][1]||'')!==String(userId||'')) continue;
    if (String(rows[i][6]||'').toUpperCase()!=='ACTIVE') continue;
    statusValues[i][0]='REVOKED';
    const hash=String(rows[i][2]||'');
    if(hash) revokedHashes.push(hash);
    count++;
  }
  if (count) {
    sheet.getRange(2,7,statusValues.length,1).setValues(statusValues);
    revokedHashes.forEach(h=>{try{CacheService.getScriptCache().remove('PSB_SESSION_ROW_V1_'+h.substring(0,40));}catch(e){}});
  }
  return count;
}

function cleanupPSBSessions_(limit) {
  const sheet = getDatabaseSpreadsheet_().getSheetByName('SESSIONS');
  if (!sheet || sheet.getLastRow() < 2) return {processed:0,expired:0,idle:0};
  const max = Math.max(1, Number(limit || getConfig_('SESSION_CLEANUP_BATCH') || 500));
  const lastRow = sheet.getLastRow();
  const rows = sheet.getRange(2,1,lastRow-1,7).getValues();
  const statusValues = rows.map(row => [row[6]]);
  const expiredHashes = [];
  const now = new Date();
  const idleMinutes = Number(getConfig_('SESSION_IDLE_MINUTES')) || PSB_AUTH.SESSION_IDLE_MINUTES;
  let processed=0, expired=0, idle=0;
  for(let i=0;i<rows.length && processed<max;i++){
    const status=String(rows[i][6]||'').toUpperCase();
    if(status!=='ACTIVE') continue;
    const expires=rows[i][4]?new Date(rows[i][4]):null;
    const lastSeen=rows[i][5]?new Date(rows[i][5]):rows[i][3]?new Date(rows[i][3]):now;
    let next='';
    if(expires && expires<=now) { next='EXPIRED'; expired++; }
    else if((now.getTime()-lastSeen.getTime())>idleMinutes*60000) { next='IDLE_TIMEOUT'; idle++; }
    if(next){
      statusValues[i][0]=next;
      const hash=String(rows[i][2]||'');
      if(hash) expiredHashes.push(hash);
      processed++;
    }
  }
  if (processed) {
    sheet.getRange(2,7,statusValues.length,1).setValues(statusValues);
    expiredHashes.forEach(h=>{try{CacheService.getScriptCache().remove('PSB_SESSION_ROW_V1_'+h.substring(0,40));}catch(e){}});
  }
  return {processed:processed,expired:expired,idle:idle};
}

function runSecurityMaintenance(sessionToken) {
  const actor=requireRole_(sessionToken, PSB_SECURITY_ADMIN_ROLES);
  const lock=LockService.getScriptLock();
  try { lock.waitLock(10000); } catch (lockError) { return fail_('Server sedang memproses permintaan lain. Silakan coba kembali beberapa saat lagi.'); }
  let result;
  try { result=cleanupPSBSessions_(getConfig_('SESSION_CLEANUP_BATCH') || 500); }
  finally { lock.releaseLock(); }
  writeAudit_(actor.userId,'SECURITY_MAINTENANCE','SECURITY','', '', JSON.stringify(result), 'Maintenance keamanan dijalankan oleh SUPERADMIN');
  return {success:true, result:result};
}

function invalidateSession_(found, status) {
  if (!found || !found.rowNumber) return false;
  const lock=LockService.getScriptLock();
  try { lock.waitLock(5000); } catch (lockError) { return false; }
  try {
    const sheet=getDatabaseSpreadsheet_().getSheetByName('SESSIONS');
    if(!sheet || found.rowNumber>sheet.getLastRow())return false;
    const current=sheet.getRange(found.rowNumber,1,1,7).getValues()[0];
    const expectedHash=String((found.row||[])[2]||'');
    if(expectedHash && !constantTimeEqual_(String(current[2]||''),expectedHash))return false;
    // A concurrent logout/reset/cleanup may already have ended this session.
    // Treat that as success, but never overwrite its more specific terminal state.
    if(String(current[6]||'').toUpperCase()!=='ACTIVE'){
      try{const tokenHash=String(current[2]||'');if(tokenHash)CacheService.getScriptCache().remove('PSB_SESSION_ROW_V1_'+tokenHash.substring(0,40));}catch(e){}
      return true;
    }
    // A stale validation snapshot must not expire a session that another
    // request refreshed while this invalidation waited for the lock.
    const now=new Date(), reason=String(status||'REVOKED').toUpperCase();
    if(reason==='INVALID_EXPIRY'){
      const expires=current[4]?new Date(current[4]):null;
      if(expires && Number.isFinite(expires.getTime()))return true;
    } else if(reason==='EXPIRED'){
      const expires=current[4]?new Date(current[4]):null;
      if(expires && Number.isFinite(expires.getTime()) && expires>now)return true;
    } else if(reason==='INVALID_ACTIVITY'){
      const activity=current[5]?new Date(current[5]):(current[3]?new Date(current[3]):null);
      if(activity && Number.isFinite(activity.getTime()) && activity.getTime()<=now.getTime()+5*60000)return true;
    } else if(reason==='IDLE_TIMEOUT'){
      const activity=current[5]?new Date(current[5]):(current[3]?new Date(current[3]):null);
      const idleMinutes=Number(getConfig_('SESSION_IDLE_MINUTES'))||PSB_AUTH.SESSION_IDLE_MINUTES;
      if(activity && Number.isFinite(activity.getTime()) && activity.getTime()<=now.getTime()+5*60000 &&
          (now.getTime()-activity.getTime())<=idleMinutes*60000)return true;
    } else if(reason==='ACCOUNT_INACTIVE'){
      const user=findUserById_(String(current[1]||''),true);
      if(user && String(user.status).toUpperCase()==='ACTIVE')return true;
    }
    sheet.getRange(found.rowNumber,7).setValue(status || 'REVOKED');
    try {
      const tokenHash=String(current[2]||'');
      if(tokenHash)CacheService.getScriptCache().remove('PSB_SESSION_ROW_V1_'+tokenHash.substring(0,40));
    } catch (e) {}
    return true;
  } finally { lock.releaseLock(); }
}

// =====================================================
// USER / PASSWORD
// =====================================================

function findUser_(key) {
  const normalized = String(key || '').toLowerCase();
  if (!normalized) return null;
  const cache = CacheService.getScriptCache();
  const cacheKey = 'PSB_USER_ROW_LOGIN_V1_' + sha256Hex_(normalized).substring(0, 32);
  const sheet = getDatabaseSpreadsheet_().getSheetByName('USERS');
  if (!sheet) return null;

  function matches(row) {
    return String(row[3] || '').trim().toLowerCase() === normalized ||
      String(row[5] || '').trim().toLowerCase() === normalized ||
      String(row[2] || '').trim().toLowerCase() === normalized ||
      String(row[4] || '').trim().toLowerCase() === normalized;
  }

  // Cache hanya menyimpan lokasi baris. Data akun selalu dibaca fresh agar
  // perubahan status/password tidak tertahan oleh cache objek pengguna.
  // Cache hanya indeks. Jika CacheService sementara tidak tersedia,
  // lanjutkan pencarian langsung ke USERS agar login tetap dapat diproses.
  let cachedRowNumber = 0;
  try { cachedRowNumber = Number(cache.get(cacheKey) || 0); } catch (cacheReadError) {}
  if (cachedRowNumber >= 2) {
    try {
      const row = sheet.getRange(cachedRowNumber, 1, 1, 15).getValues()[0];
      if (matches(row)) {
        try { cache.put('PSB_USER_ROW_ID_V1_' + sha256Hex_(String(row[0] || '')).substring(0, 32), String(cachedRowNumber), 21600); } catch (e) {}
        return userFromRow_(row, cachedRowNumber);
      }
    } catch (e) {}
    try { cache.remove(cacheKey); } catch (cacheRemoveError) {}
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;
  // Identity lookup only needs USERS columns C:F (phone, normalized phone,
  // email, normalized email). Fetch the complete account row only on a match.
  const identities = sheet.getRange(2, 3, lastRow - 1, 4).getValues();
  for (let i = 0; i < identities.length; i++) {
    const identity = identities[i];
    const normalizedMatch = String(identity[1] || '').trim().toLowerCase() === normalized ||
      String(identity[3] || '').trim().toLowerCase() === normalized;
    const legacyMatch = String(identity[0] || '').trim().toLowerCase() === normalized ||
      String(identity[2] || '').trim().toLowerCase() === normalized;
    if (normalizedMatch || legacyMatch) {
      const rowNumber = i + 2;
      const row = sheet.getRange(rowNumber, 1, 1, 15).getValues()[0];
      try {
        cache.put(cacheKey, String(rowNumber), 21600);
        cache.put('PSB_USER_ROW_ID_V1_' + sha256Hex_(String(row[0] || '')).substring(0, 32), String(rowNumber), 21600);
      } catch (e) {}
      return userFromRow_(row, rowNumber);
    }
  }
  return null;
}

function findUserById_(id, bypassCache) {
  const value = String(id || '');
  if (!value) return null;
  const cache = CacheService.getScriptCache();
  const cacheKey = 'PSB_USER_ROW_ID_V1_' + sha256Hex_(value).substring(0, 32);
  const sheet = getDatabaseSpreadsheet_().getSheetByName('USERS');
  if (!sheet) return null;

  // bypassCache dipertahankan untuk kompatibilitas pemanggil lama. Indeks saja
  // yang di-cache; isi baris pengguna selalu dibaca terbaru dari Spreadsheet.
  // Cache hanya indeks. Kegagalan baca cache harus jatuh kembali ke scan USERS.
  let cachedRowNumber = 0;
  try { cachedRowNumber = Number(cache.get(cacheKey) || 0); } catch (cacheReadError) {}
  if (cachedRowNumber >= 2) {
    try {
      const row = sheet.getRange(cachedRowNumber, 1, 1, 15).getValues()[0];
      if (String(row[0] || '') === value) return userFromRow_(row, cachedRowNumber);
    } catch (e) {}
    try { cache.remove(cacheKey); } catch (cacheRemoveError) {}
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;
  // USER ID is column A; avoid transferring all 15 account columns on a cache miss.
  const ids = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
  for (let i = 0; i < ids.length; i++) {
    if (String(ids[i][0] || '') === value) {
      const rowNumber = i + 2;
      const row = sheet.getRange(rowNumber, 1, 1, 15).getValues()[0];
      try { cache.put(cacheKey, String(rowNumber), 21600); } catch (e) {}
      return userFromRow_(row, rowNumber);
    }
  }
  return null;
}

function userFromRow_(r, rowNumber) {
  return {
    rowNumber: rowNumber, userId: String(r[0] || ''), name: String(r[1] || ''), phone: String(r[2] || ''),
    phoneNormalized: String(r[3] || ''), email: String(r[4] || ''), emailNormalized: String(r[5] || ''),
    passwordHash: String(r[6] || ''), passwordSalt: String(r[7] || ''), role: String(r[8] || ''), status: String(r[9] || ''),
    photoFileId: String(r[10] || ''), lastLoginAt: r[11], createdAt: r[12], updatedAt: r[13], mustChangePassword: r[14]
  };
}

function publicUser_(u) {
  return { userId: u.userId, name: u.name, phone: u.phone, email: u.email, role: u.role, status: u.status, photoFileId: u.photoFileId || '' };
}

function updateLastLogin_(rowNumber) {
  getDatabaseSpreadsheet_().getSheetByName('USERS').getRange(rowNumber, 12).setValue(new Date());
}

function getUserManagementData(sessionToken) {
  requireRole_(sessionToken, ['SUPERADMIN']);
  const sheet = getDatabaseSpreadsheet_().getSheetByName('USERS');
  if (!sheet || sheet.getLastRow() < 2) return { success: true, users: [], roles: PSB_ROLES.slice() };
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, Math.min(15, sheet.getLastColumn())).getValues();
  const users = rows.map((r, i) => ({
    userId: String(r[0] || ''),
    name: String(r[1] || ''),
    phone: String(r[2] || ''),
    email: String(r[4] || ''),
    role: String(r[8] || ''),
    status: String(r[9] || ''),
    createdAt: r[12] instanceof Date ? r[12].toISOString() : String(r[12] || ''),
    updatedAt: r[13] instanceof Date ? r[13].toISOString() : String(r[13] || ''),
    mustChangePassword: r[14] === true || String(r[14] || '').toUpperCase() === 'TRUE'
  })).sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)));
  return { success: true, users: users, roles: PSB_ROLES.slice() };
}

function adminResetUserPassword(sessionToken, payload) {
  const actor = requireRole_(sessionToken, ['SUPERADMIN']);
  assertOperationalMutation_(actor);
  payload = payload || {};

  const userId = String(payload.userId || '').trim();
  const newPassword = String(payload.newPassword || '');
  const confirmPassword = String(payload.confirmPassword || '');
  if (!userId) return fail_('User ID wajib diisi.');
  if (newPassword.trim().length === 0 || newPassword.length < 6 || newPassword.length > 128) return fail_('Password baru harus terdiri dari 6 sampai 128 karakter.');
  if (newPassword !== confirmPassword) return fail_('Konfirmasi password tidak sama.');

  const targetBeforeLock = findUserById_(userId, true);
  if (!targetBeforeLock) return fail_('Pengguna tidak ditemukan.');
  const salt = Utilities.getUuid().replace(/-/g, '').substring(0, 32);
  const hash = hashPassword_(newPassword, salt);
  const lock = LockService.getScriptLock();
  try { lock.waitLock(20000); } catch (lockError) { return fail_('Server sedang memproses permintaan lain. Silakan coba kembali beberapa saat lagi.'); }
  try {
    const target = findUserById_(userId, true);
    if (!target || target.passwordHash !== targetBeforeLock.passwordHash || target.passwordSalt !== targetBeforeLock.passwordSalt || String(target.status).toUpperCase() !== String(targetBeforeLock.status).toUpperCase()) return fail_('Data pengguna telah berubah. Silakan ulangi reset password.');
    const sheet = getDatabaseSpreadsheet_().getSheetByName('USERS');
    if (!sheet) return fail_('Sheet USERS tidak ditemukan.');

    // USERS: passwordHash=7, passwordSalt=8, role=9, updatedAt=14, mustChangePassword=15.
    sheet.getRange(target.rowNumber, 7, 1, 3).setValues([[hash, salt, target.role]]);
    sheet.getRange(target.rowNumber, 14, 1, 2).setValues([[new Date(), true]]);

    const revoked = revokeOtherSessionsForUser_(target.userId, 0);
    try {
      if (target.phoneNormalized) CacheService.getScriptCache().remove('PSB_USER_V3_' + sha256Hex_(String(target.phoneNormalized).toLowerCase()).substring(0, 32));
      if (target.emailNormalized) CacheService.getScriptCache().remove('PSB_USER_V3_' + sha256Hex_(String(target.emailNormalized).toLowerCase()).substring(0, 32));
      CacheService.getScriptCache().remove('PSB_USER_ID_' + sha256Hex_(String(target.userId)).substring(0, 32));
    } catch (e) {}

    writeAudit_(actor.userId, 'RESET_PASSWORD', 'USER', target.userId, '', JSON.stringify({targetUserId:target.userId}), 'SUPERADMIN mereset password pengguna');
    return {success:true, message:'Password pengguna berhasil direset. Pengguna wajib mengganti password saat login berikutnya.', revokedSessions:revoked};
  } finally {
    lock.releaseLock();
  }
}

function createManualUser(sessionToken, payload) {
  const actor = requireRole_(sessionToken, ['SUPERADMIN']);
  assertOperationalMutation_(actor);
  payload = payload || {};

  const name = String(payload.name || '').trim();
  const phone = String(payload.phone || '').trim();
  const email = String(payload.email || '').trim();
  const password = String(payload.password || '');
  const confirmPassword = String(payload.confirmPassword || '');
  const status = String(payload.status || 'ACTIVE').trim().toUpperCase() === 'INACTIVE' ? 'INACTIVE' : 'ACTIVE';
  const requestedRoles = Array.isArray(payload.roles) ? payload.roles : String(payload.role || '').split(',');
  const roles = Array.from(new Set(requestedRoles.map(x => String(x || '').trim().toUpperCase()).filter(Boolean)));

  if (!name || name.length > 120) return fail_('Nama lengkap wajib diisi (maksimal 120 karakter).');
  if (!phone && !email) return fail_('No. HP atau Email wajib diisi minimal salah satu.');
  if (phone && !/^62\d{8,13}$/.test(normalizePhone_(phone))) return fail_('No. HP tidak valid.');
  if (email && (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))) return fail_('Format email tidak valid.');
  if (!roles.length) return fail_('Pilih minimal satu role.');
  if (roles.some(r => PSB_ROLES.indexOf(r) < 0)) return fail_('Role akun tidak sesuai dengan role yang tersedia.');
  if (password.length < 6) return fail_('Password minimal 6 karakter.');
  if (password !== confirmPassword) return fail_('Konfirmasi password tidak sama.');

  const phoneNormalized = phone ? normalizePhone_(phone) : '';
  const emailNormalized = email ? email.toLowerCase() : '';
  const salt = Utilities.getUuid().replace(/-/g, '').substring(0, 32);
  const hash = hashPassword_(password, salt);
  const lock = LockService.getScriptLock();
  try { lock.waitLock(10000); } catch (lockError) { return fail_('Server sedang memproses permintaan lain. Silakan coba kembali beberapa saat lagi.'); }
  try {
    const sheet = getDatabaseSpreadsheet_().getSheetByName('USERS');
    if (!sheet) return fail_('Database USERS belum tersedia. Jalankan setupPSBDatabase() terlebih dahulu.');
    const rows = sheetRowsByFields_(sheet, ['phone','phoneNormalized','email','emailNormalized']);
    for (let i = 0; i < rows.length; i++) {
      const r = rows[i];
      // Legacy accounts may not yet have normalized identity columns populated.
      const existingPhone=String(r.phoneNormalized||'').trim() || (r.phone?normalizePhone_(r.phone):'');
      const existingEmail=String(r.emailNormalized||'').trim().toLowerCase() || String(r.email||'').trim().toLowerCase();
      if (phoneNormalized && existingPhone.toLowerCase() === phoneNormalized.toLowerCase()) return fail_('No. HP sudah terdaftar.');
      if (emailNormalized && existingEmail === emailNormalized) return fail_('Email sudah terdaftar.');
    }

    const now = new Date();
    const userId = generateId_('USR');
    const values = [
      userId, name, phone, phoneNormalized, email, emailNormalized,
      hash, salt, roles.join(','), status, '', '', now, now, true
    ];
    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(String);
    const canonical = PSB_HEADERS.USERS || [];
    const idx = {};
    canonical.forEach((h, i) => { idx[h] = i; });
    const row = headers.map(h => idx[h] === undefined ? '' : values[idx[h]]);
    sheet.getRange(sheet.getLastRow() + 1, 1, 1, headers.length).setValues([row]);

    if (phoneNormalized) CacheService.getScriptCache().remove('PSB_USER_V3_' + sha256Hex_(phoneNormalized.toLowerCase()).substring(0, 32));
    if (emailNormalized) CacheService.getScriptCache().remove('PSB_USER_V3_' + sha256Hex_(emailNormalized).substring(0, 32));
    writeAudit_(actor.userId, 'CREATE', 'USER', userId, '', JSON.stringify({ name: name, phone: phoneNormalized, email: emailNormalized, role: roles.join(','), status: status }), 'Akun pengguna dibuat manual oleh SUPERADMIN');

    return {
      success: true,
      message: 'Akun pengguna berhasil dibuat. Pengguna wajib mengganti password saat login pertama.',
      user: { userId: userId, name: name, phone: phone, email: email, role: roles.join(','), status: status, mustChangePassword: true }
    };
  } finally {
    lock.releaseLock();
  }
}


function normalizeIdentifier_(identifier) {
  const raw = String(identifier || '').trim();
  if (!raw) return '';
  if (raw.indexOf('@') >= 0) return raw.toLowerCase();
  // Username legacy/bootstrap (mis. Superadmin) bukan nomor telepon.
  // Nomor telepon Indonesia umumnya dimulai +, 0, 8, 62, atau 00.
  if (/^[+0-9][0-9 .()\-]*$/.test(raw)) return normalizePhone_(raw);
  return raw.toLowerCase();
}

function normalizePhone_(phone) {
  let p = String(phone || '').replace(/[^0-9]/g, '');
  if (p.indexOf('00') === 0) p = p.substring(2);
  if (p.indexOf('0') === 0) p = '62' + p.substring(1);
  else if (p.indexOf('8') === 0) p = '62' + p;
  return p;
}

// Password hashing: kompatibilitas format awal PSB, SHA-256(password + salt).
const PSB_PASSWORD_HASH_SCHEME_ = 'pbkdf2_sha256';
const PSB_PASSWORD_HASH_ITERATIONS_ = 60000;
const PSB_PASSWORD_HASH_MIN_ITERATIONS_ = 10000;
const PSB_PASSWORD_HASH_MAX_ITERATIONS_ = 250000;

function hashPassword_(password, salt) {
  // Format historis PSB: SHA-256(password + salt).
  return sha256Hex_(String(password) + String(salt));
}

function verifyPasswordForUser_(password, user) {
  const stored = String(user && user.passwordHash || '').trim();
  const salt = String(user && user.passwordSalt || '');
  if (!stored || !salt) return { valid: false, needsUpgrade: false };

  // Tetap dukung akun yang sebelumnya sudah dimigrasikan ke PBKDF2.
  const pbkdf2Prefix = PSB_PASSWORD_HASH_SCHEME_ + String.fromCharCode(36);
  if (stored.indexOf(pbkdf2Prefix) === 0) {
    const parts = stored.split(String.fromCharCode(36));
    const iterations = Number(parts[1]);
    if (parts.length !== 3 || !Number.isInteger(iterations) ||
        iterations < PSB_PASSWORD_HASH_MIN_ITERATIONS_ ||
        iterations > PSB_PASSWORD_HASH_MAX_ITERATIONS_ ||
        !/^[a-f0-9]{64}$/i.test(parts[2])) return { valid: false, needsUpgrade: false };
    const actual = pbkdf2Sha256Hex_(String(password), salt, iterations);
    const valid = constantTimeEqual_(actual, parts[2].toLowerCase());
    return { valid: valid, needsUpgrade: valid };
  }

  // Format awal PSB: SHA-256(password + salt).
  if (!/^[a-f0-9]{64}$/i.test(stored)) return { valid: false, needsUpgrade: false };
  const legacy = sha256Hex_(String(password) + salt);
  return { valid: constantTimeEqual_(legacy, stored.toLowerCase()), needsUpgrade: false };
}
function pbkdf2Sha256Hex_(password, salt, iterations) {
  const keyBytes = Utilities.newBlob(String(password), 'text/plain').getBytes();
  const saltBytes = Utilities.newBlob(String(salt), 'text/plain').getBytes();
  const block = saltBytes.concat([0, 0, 0, 1]);
  let u = Utilities.computeHmacSha256Signature(block, keyBytes);
  const output = u.slice();
  for (let i = 1; i < iterations; i++) {
    u = Utilities.computeHmacSha256Signature(u, keyBytes);
    for (let j = 0; j < output.length; j++) output[j] = output[j] ^ u[j];
  }
  return output.map(b => (b < 0 ? b + 256 : b).toString(16).padStart(2, '0')).join('');
}

function migratePbkdf2PasswordToLegacySha256AfterLogin_(verifiedUser, password) {
  // Migrasi hanya setelah PBKDF2 berhasil diverifikasi. Hash dibuat di luar lock.
  const beforeLock = findUserById_(verifiedUser.userId, true);
  if (!beforeLock || String(beforeLock.status).toUpperCase() !== 'ACTIVE' ||
      beforeLock.passwordHash !== verifiedUser.passwordHash ||
      beforeLock.passwordSalt !== verifiedUser.passwordSalt) return false;

  const salt = Utilities.getUuid().replace(/-/g, '').substring(0, 32);
  const hash = hashPassword_(String(password), salt);
  const lock = LockService.getScriptLock();
  try { lock.waitLock(20000); } catch (lockError) { return false; }
  try {
    const current = findUserById_(verifiedUser.userId, true);
    if (!current || String(current.status).toUpperCase() !== 'ACTIVE' ||
        current.passwordHash !== verifiedUser.passwordHash ||
        current.passwordSalt !== verifiedUser.passwordSalt) return false;
    const sheet = getDatabaseSpreadsheet_().getSheetByName('USERS');
    if (!sheet) return false;
    sheet.getRange(current.rowNumber, 7, 1, 2).setValues([[hash, salt]]);
    try {
      if (current.phoneNormalized) CacheService.getScriptCache().remove('PSB_USER_V3_' + sha256Hex_(String(current.phoneNormalized).toLowerCase()).substring(0, 32));
      if (current.emailNormalized) CacheService.getScriptCache().remove('PSB_USER_V3_' + sha256Hex_(String(current.emailNormalized).toLowerCase()).substring(0, 32));
      CacheService.getScriptCache().remove('PSB_USER_ID_' + sha256Hex_(String(current.userId)).substring(0, 32));
    } catch (cacheError) {}
    try {
      writeAudit_(current.userId, 'PASSWORD_HASH_MIGRATED', 'AUTH', current.userId,
        'PBKDF2_SHA256', 'SHA256', 'Hash password dikembalikan ke format SHA-256 historis PSB setelah login berhasil');
    } catch (auditError) {}
    return true;
  } finally { lock.releaseLock(); }
}
function sha256Hex_(value) {
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(value), Utilities.Charset.UTF_8);
  return bytes.map(b => (b < 0 ? b + 256 : b).toString(16).padStart(2, '0')).join('');
}

function constantTimeEqual_(a, b) {
  a = String(a || ''); b = String(b || '');
  let diff = a.length ^ b.length;
  const n = Math.max(a.length, b.length);
  for (let i = 0; i < n; i++) diff |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
  return diff === 0;
}

// =====================================================
// BRUTE FORCE PROTECTION (CacheService)
// =====================================================

function registerLoginFailure_(key) {
  const cache = CacheService.getScriptCache();
  const hash = sha256Hex_(key).substring(0, 32);
  const cacheKey = 'PSB_LOGIN_FAIL_V2_' + hash;
  const max = Number(getConfig_('LOGIN_MAX_ATTEMPTS')) || PSB_AUTH.MAX_ATTEMPTS;
  const lockMin = Number(getConfig_('LOGIN_LOCK_MINUTES')) || PSB_AUTH.LOCK_MINUTES;
  // CacheService tidak menyediakan increment atomik. Script Lock mencegah
  // dua request login bersamaan menimpa penghitung percobaan satu sama lain.
  const guard = LockService.getScriptLock();
  try { guard.waitLock(5000); } catch (lockError) {
    // Fail closed saat penghitung tidak bisa diperbarui karena lock contention.
    // Marker sementara mencegah percobaan berulang melewati proteksi.
    try { cache.put('PSB_LOGIN_LOCK_V2_' + hash, String(Date.now() + 60000), 60); } catch (cacheError) {}
    return { attempts: max, locked: true, contention: true };
  }
  try {
    const current = Math.max(0, Number(cache.get(cacheKey) || 0)) + 1;
    cache.put(cacheKey, String(current), lockMin * 60);
    if (current >= max) {
      cache.put('PSB_LOGIN_LOCK_V2_' + hash, String(Date.now() + lockMin * 60000), lockMin * 60);
    }
    return { attempts: current, locked: current >= max };
  } finally {
    guard.releaseLock();
  }
}

function getLoginLock_(key) {
  const cache = CacheService.getScriptCache();
  const k = 'PSB_LOGIN_LOCK_V2_' + sha256Hex_(key).substring(0, 32);
  const until = Number(cache.get(k) || 0);
  if (until > Date.now()) return { locked: true, remainingMinutes: Math.max(1, Math.ceil((until - Date.now()) / 60000)) };
  return { locked: false };
}

function clearLoginFailure_(key) {
  const cache = CacheService.getScriptCache();
  const h = sha256Hex_(key).substring(0, 32);
  const guard = LockService.getScriptLock();
  try { guard.waitLock(5000); } catch (lockError) { return false; }
  try {
    cache.remove('PSB_LOGIN_FAIL_V2_' + h);
    cache.remove('PSB_LOGIN_LOCK_V2_' + h);
    return true;
  } finally {
    guard.releaseLock();
  }
}

